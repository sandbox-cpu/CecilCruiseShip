# Copy this file to .env (in this folder) and fill in what you need.
# Everything is optional for running locally.

# Password for /admin, where you can see, export and remove sign-ups.
# Use a long random string. Any username works. Admin is switched off while this is empty.
ADMIN_TOKEN=

# Where sign-ups are saved (a SQLite file). Default: data/waitlist.db
# On a host, point this at a persistent disk or volume, e.g. /var/data/waitlist.db
# WAITLIST_DB=

# The public address, used for link previews (Open Graph / social cards).
# SITE_URL=https://cecil.example.com

# Behind a hosting provider's load balancer (Render, Railway, Fly, etc.), set this
# so rate limiting sees each visitor's real address.
# TRUST_PROXY=1

# PORT=4000
