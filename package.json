{
  "name": "cecil-mystery",
  "version": "0.1.0",
  "private": true,
  "description": "Cecil: AI-hosted, asymmetric murder mysteries for 3-4 players. Laptop is the shared screen, phones are private. Two cases: Dead Reckoning (aboard the SS Halcyon) and A Nightcap at Ravensmere.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "halcyon": "node server/index.js --case=halcyon",
    "ravensmere": "node server/index.js --case=ravensmere",
    "remote": "node scripts/remote.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 --test-reporter=spec \"test/browser/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.3"
  }
}
