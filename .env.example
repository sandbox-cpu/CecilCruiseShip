# Copy this file to .env (in this folder) and fill in what you have.
# Everything is optional: with no keys at all, Cecil runs fully scripted
# and speaks with the browser's built-in voice.

# Cecil's brain: live Claude. Leave blank to run scripted.
ANTHROPIC_API_KEY=
# CECIL_MODEL=claude-opus-5
# CECIL_AI_TIMEOUT_MS=20000
# CECIL_AI=off              # force scripted mode even with a key

# Cecil's voice: ElevenLabs. Leave blank to use the browser's voice.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George"; any voice ID from your library
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# The server
# PORT=3000
# GAME_SPEED=1              # 2 = a seven-minute demo; 1 = the full fifteen minutes
# PUBLIC_URL=http://192.168.1.20:3000   # only if the QR code shows the wrong address
